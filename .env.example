# Copy to `.env` and fill in real values. `.env` is git-ignored.
# Local-only example: admin/admin is fine on a laptop.
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin
POSTGRES_DB=postgres

# The Odoo database and the admin login `seed/seed.py` uses by default.
ODOO_DB=development-odoo
ODOO_URL=http://localhost:8069
ODOO_USER=admin
ODOO_PASSWORD=admin
