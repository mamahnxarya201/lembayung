<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="kula_pos_layout.ActionpadWidget"
       t-inherit="point_of_sale.ActionpadWidget"
       t-inherit-mode="extension">

        <!-- Selector note: `hasclass('pay')`, NOT hasclass('pay-order-button').
             A hyphenated class inside hasclass() never matches: template
             inheritance rewrites hasclass() itself (see getXpath in
             template_inheritance.js) and the hyphenated form comes out
             unmatchable, even though the equivalent raw XPath matches fine.
             ' pay ' is unique to this button - "fast-pay-button" and
             "pay-button" do not contain it. For classes that only exist in
             hyphenated form, use contains(@class, '...') instead.

             Core's button carries t-out="props.actionName", and t-out owns the
             element's content at render time: position="inside" content gets
             wiped. An empty <attribute/> removes the attribute (see
             modifyAttributes), handing the content back to the template.
             Keeping the node also keeps pos_restaurant's attribute extension on
             it working. -->
        <xpath expr="//button[hasclass('pay')]" position="attributes">
            <attribute name="t-out"/>
            <attribute name="class" add="kula-pay" separator=" "/>
        </xpath>

        <xpath expr="//button[hasclass('pay')]" position="inside">
            <span class="kula-pay-label" t-out="props.actionName"/>
            <span class="kula-pay-total" t-if="currentOrder"
                  t-esc="currentOrder.currencyDisplayPriceIncl"/>
        </xpath>

        <!-- Save Order: park the order under a name the cashier types.

             A sibling of the Payment container, so it lands under it at the full
             pane width with the actionpad's own gap — the same size and shape as
             Payment, and deliberately a different colour (§16 of the SCSS), so
             the two big actions on this screen are never mistaken for each
             other. Inside the `showActionButton` block, which is core's "the
             order is not empty" condition: there is nothing to save otherwise. -->
        <xpath expr="//div[hasclass('validation')]" position="after">
            <button class="kula-save-order button btn btn-lg py-3 d-flex align-items-center justify-content-center"
                    t-on-click="() => this.kulaSaveOrder()">
                <i class="fa fa-bookmark me-2" aria-hidden="true"/>
                <span>Save Order</span>
            </button>
        </xpath>
    </t>
</templates>
