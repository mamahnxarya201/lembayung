<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <!-- Fills the "kula-controls" slot that kula_pos_layout.OrderLine injects into
         core's point_of_sale.Orderline, so every line in the order pane gets its
         own − / + stepper and a delete button.

         Why this instead of core's own affordances: in v19 a line can only be
         changed by selecting it (which is the only way the numpad appears) and
         then either typing a new quantity or pressing ⌫. Nothing on screen says
         so, and deselecting is a second tap on the line. These three buttons act
         on the line directly.

         `line` comes from the OrderDisplay slot scope already set by the core
         template (`t-set="line" t-value="scope.line"`), the same variable core's
         own pack-lot-icon slot uses. -->
    <t t-name="kula_pos_layout.OrderSummary"
       t-inherit="point_of_sale.OrderSummary"
       t-inherit-mode="extension">

        <xpath expr="//Orderline" position="inside">
            <t t-set-slot="kula-controls">
                <!-- No stepper on a combo child: it is display-only here and the
                     quantity belongs to its parent, which is what the handlers
                     below resolve to anyway. -->
                <div t-if="!line.combo_parent_id" class="kula-line-controls"
                     t-on-pointerdown.stop=""
                     t-on-pointerup.stop=""
                     t-on-click.stop="">

                    <button type="button" class="kula-line-btn kula-line-minus"
                            title="Remove one" aria-label="Remove one"
                            t-on-click.stop="() => this.kulaStepQuantity(line, -1)">
                        <i class="fa fa-minus" aria-hidden="true"/>
                    </button>

                    <span class="kula-line-qty" t-esc="this.kulaLineQty(line)"/>

                    <button type="button" class="kula-line-btn kula-line-plus"
                            title="Add one" aria-label="Add one"
                            t-on-click.stop="() => this.kulaStepQuantity(line, 1)">
                        <i class="fa fa-plus" aria-hidden="true"/>
                    </button>

                    <button type="button" class="kula-line-btn kula-line-trash"
                            title="Delete line" aria-label="Delete line"
                            t-on-click.stop="() => this.kulaRemoveLine(line)">
                        <i class="fa fa-trash" aria-hidden="true"/>
                    </button>
                </div>
            </t>
        </xpath>
    </t>
</templates>
