<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="kula_pos_layout.ControlButtons"
       t-inherit="point_of_sale.ControlButtons"
       t-inherit-mode="extension">

        <!-- "Note" was not requested. An empty replace removes the node, since
             template inheritance has no position="remove". -->
        <xpath expr="//InternalNoteButton" position="replace"/>

        <!-- "Save / park order" was not requested. Uses contains(@class, ...)
             rather than hasclass('fa-upload') because hasclass() does not match
             hyphenated class names (see action_pad.xml for the full note). -->
        <xpath expr="//button[i[contains(@class, 'fa-upload')]]" position="replace"/>

        <!-- Refund promoted out of the (...) popup onto the main row. Customer is
             core's own SelectPartnerButton and is deliberately left untouched. -->
        <xpath expr="//SelectPartnerButton" position="after">
            <button t-if="!props.showRemainingButtons and this.pos.cashier._role != 'minimal'"
                    class="kula-refund btn btn-secondary btn-lg"
                    t-on-click="() => this.clickRefund()">
                <i class="fa fa-undo me-1" role="img" aria-label="Refund" title="Refund"/>
                Refund
            </button>
        </xpath>

        <!-- The (...) button is kept by default: in Odoo 19 it is the only route
             to "Cancel Order" and "Pricelist" from this screen. Turn it off in
             Settings if those are genuinely not needed at the counter.
             contains(@class, ...) again, because "more-btn" is hyphenated. -->
        <xpath expr="//button[contains(@class, 'more-btn')]" position="attributes">
            <attribute name="t-if" add="pos.config.kula_show_more_button" separator=" and "/>
        </xpath>
    </t>
</templates>
