<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="kula_pos_layout.ControlButtons"
       t-inherit="point_of_sale.ControlButtons"
       t-inherit-mode="extension">

        <!-- "Note" was not requested. An empty replace removes the node, since
             template inheritance has no position="remove". -->
        <xpath expr="//InternalNoteButton" position="replace"/>

        <!-- "Save / park order" (core's upload button) was not requested on this
             row; the Save Order button in the actionpad replaces it, and asks
             for the order's title first. Uses contains(@class, ...) rather than
             hasclass('fa-upload') because hasclass() does not match hyphenated
             class names (see action_pad.xml for the full note). -->
        <xpath expr="//button[i[contains(@class, 'fa-upload')]]" position="replace"/>

        <!-- Customer removed on request: this counter identifies an order by the
             name the cashier types into Save Order, not by a partner record, and
             the row is being kept to the payment flow. It is core's own
             SelectPartnerButton — the node only exists in this template, and it
             is conditional on `!props.showRemainingButtons`, so removing it
             leaves the "(...)" popup's own list untouched. -->
        <xpath expr="//SelectPartnerButton" position="replace"/>

        <!-- Refund was promoted onto this row by an earlier revision and is
             removed on request. It stays reachable in the "(...)" popup, whose
             list (Cancel Order, Pricelist, Refund, ...) this module does not
             change. -->

        <!-- The (...) button is kept by default: in Odoo 19 it is the only route
             to "Cancel Order", "Pricelist" and now "Refund" from this screen.
             Turn it off in Settings if those are genuinely not needed at the
             counter. contains(@class, ...) again, because "more-btn" is
             hyphenated. -->
        <xpath expr="//button[contains(@class, 'more-btn')]" position="attributes">
            <attribute name="t-if" add="pos.config.kula_show_more_button" separator=" and "/>
        </xpath>

        <!-- ...and labelled. An ellipsis alone asks the reader to know what is
             behind it; on a counter tablet the row is tapped by whoever is
             standing there, so the button says what it is. The icon stays
             (core's own), and the popup behind it is unchanged: Cancel Order,
             Pricelist, Refund, ... -->
        <xpath expr="//button[contains(@class, 'more-btn')]" position="inside">
            <span class="kula-action-label">Action</span>
        </xpath>
    </t>
</templates>
