<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="kula_pos_layout.ProductScreen"
       t-inherit="point_of_sale.ProductScreen"
       t-inherit-mode="extension">

        <!-- Core's in-pane category chips are rendered only when that mode is
             chosen explicitly; in kiosk mode the pane shows this module's
             category tiles instead, and in dropdown mode the navbar dropdown. -->
        <xpath expr="//CategorySelector" position="attributes">
            <attribute name="t-if" add="pos.config.kula_category_nav == 'tiles'" separator=" and "/>
        </xpath>

        <!-- The kiosk landing view: the whole menu as picture tiles.
             A sibling of core's category chips rather than a replacement of the
             product grid, because the grid's markup is core's; the two attribute
             edits below are what keep the grid from rendering underneath it. -->
        <xpath expr="//CategorySelector" position="after">
            <CategoryHome t-if="this.kulaShowCategoryHome"/>
        </xpath>

        <!-- The product grid and its empty state are an if/elif/else chain on
             consecutive siblings (the barcode-scanner node starts it), so the
             tiles' own t-if cannot switch either of them off: an if/else pair
             only sees its own chain. Both conditions therefore carry the same
             guard.

             The empty state had to stop being a t-else — an else cannot be
             conditional, and in kiosk mode the pane is showing tiles, not a
             "no products" message. Dropping the t-else attribute and adding a
             t-elif leaves every other mode with exactly the behaviour it had. -->
        <xpath expr="//div[contains(@class, 'overflow-y-auto')]" position="attributes">
            <attribute name="t-elif" add="!this.kulaShowCategoryHome" separator=" and "/>
        </xpath>
        <xpath expr="//div[@t-else]" position="attributes">
            <attribute name="t-else"/>
            <attribute name="t-elif">!this.kulaShowCategoryHome</attribute>
        </xpath>

        <!-- Quantity numpad removed from this screen.

             It existed for entering a quantity per line, and for the Price/Disc
             modes (already dropped, see product_screen.js). At this counter the
             cashier taps the product again to raise its quantity, so the pad was
             only taking ~200px of vertical space away from the order lines.

             An empty replace removes the node — template inheritance has no
             position="remove". -->
        <xpath expr="//Numpad" position="replace"/>

        <!-- Expose the configurable card width to the SCSS as a custom property.
             (Swapping the two panes and reordering the control row are done in
             SCSS, so none of core's markup is duplicated here.) -->
        <xpath expr="//div[hasclass('product-screen')]" position="attributes">
            <attribute name="t-attf-style" add="--kula-card-min: {{ pos.config.kula_card_min_width }}px;"/>
        </xpath>
    </t>
</templates>
