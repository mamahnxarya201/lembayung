<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="kula_pos_layout.PaymentScreen"
       t-inherit="point_of_sale.PaymentScreen"
       t-inherit-mode="extension">

        <!-- The tender numpad needs its own click handler.

             The pad now carries a "00" key (see payment_screen.js), and
             `sendKey("00")` is rejected: the number buffer whitelists single
             digits plus +1/+2/+5/+10/+20/+50 (number_buffer_service INPUT_KEYS).
             So clicks are routed through kulaNumpadClick, which expands "00" into
             two "0" keypresses and passes everything else straight to the buffer.

             `onClick.bind` is the same binding form core uses on the
             ProductScreen pad. -->
        <xpath expr="//Numpad" position="attributes">
            <attribute name="onClick.bind">kulaNumpadClick</attribute>
        </xpath>
    </t>

    <!-- Suggested cash amounts, directly under the big amount due.
         PaymentScreenDue is a template of its own (called by both the desktop
         and the small-screen layout), so the chips appear in both without
         touching the pane markup. The list itself is computed by
         kulaSuggestedPayments, which returns nothing until a cash payment
         line is selected. -->
    <t t-name="kula_pos_layout.PaymentScreenDue"
       t-inherit="point_of_sale.PaymentScreenDue"
       t-inherit-mode="extension">

        <xpath expr="//div[contains(@class, 'total')]" position="after">
            <div t-if="this.kulaSuggestedPayments.length"
                 class="kula-suggestions"
                 role="group"
                 aria-label="Suggested cash amounts">
                <button t-foreach="this.kulaSuggestedPayments"
                        t-as="amount"
                        t-key="amount"
                        type="button"
                        class="kula-suggestion"
                        t-on-click="() => this.kulaApplySuggestedPayment(amount)">
                    <t t-esc="this.env.utils.formatCurrency(amount)"/>
                </button>
            </div>
        </xpath>
    </t>
</templates>
