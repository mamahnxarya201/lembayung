<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <!-- Two fields and two buttons, sized for a finger: the title is the one
         thing the Orders list will show about this order, and the note rides
         along on the order itself (core's general_customer_note, the field the
         Note button writes and the receipt prints). -->
    <t t-name="kula_pos_layout.SaveOrderPopup">
        <Dialog title.translate="Save Order" size="'md'" footer="false"
                bodyClass="'kula-save-form'">
            <label class="kula-field">
                <span class="kula-field-label">Order Title</span>
                <input type="text" class="form-control form-control-lg kula-input"
                       t-model="this.state.title" placeholder="e.g. Aryana"
                       t-ref="titleInput"/>
            </label>

            <label class="kula-field">
                <span class="kula-field-label">Notes</span>
                <textarea class="form-control kula-input" rows="3"
                          t-model="this.state.notes" placeholder="e.g. less sugar"/>
            </label>

            <div class="kula-form-actions">
                <button type="button" class="btn btn-secondary btn-lg"
                        t-on-click="() => this.props.close()">
                    Cancel
                </button>
                <button type="button" class="btn btn-lg kula-save-order"
                        t-on-click="() => this.confirm()">
                    <i class="fa fa-bookmark me-2" aria-hidden="true"/>
                    Save Order
                </button>
            </div>
        </Dialog>
    </t>
</templates>
